FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.intake.txt .
RUN pip install --no-cache-dir -r requirements.intake.txt

COPY intake_api ./intake_api
COPY schemas ./schemas

RUN useradd --create-home --uid 10001 intake
USER 10001

EXPOSE 8000

CMD ["uvicorn", "intake_api.app:app", "--host", "0.0.0.0", "--port", "8000"]
