{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "${AZURE_LOCATION=uksouth}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "aiServices": {
      "value": "${AZURE_AI_SERVICES_NAME=aif-maf-poc}"
    },
    "firstProjectName": {
      "value": "${AZURE_AI_PROJECT_BASE_NAME=maf-poc-project}"
    },
    "modelName": {
      "value": "${AZURE_AI_MODEL_NAME=gpt-5.6-sol}"
    },
    "modelFormat": {
      "value": "${AZURE_AI_MODEL_FORMAT=OpenAI}"
    },
    "modelVersion": {
      "value": "${AZURE_AI_MODEL_VERSION=2026-07-09}"
    },
    "modelSkuName": {
      "value": "${AZURE_AI_MODEL_SKU_NAME=GlobalStandard}"
    },
    "modelCapacity": {
      "value": "${AZURE_AI_MODEL_CAPACITY=250}"
    },
    "foundryIqChatDeploymentName": {
      "value": "${FOUNDRY_IQ_CHAT_DEPLOYMENT_NAME=foundry-iq-chat}"
    },
    "foundryIqChatModelName": {
      "value": "${FOUNDRY_IQ_CHAT_MODEL_NAME=gpt-5.4-mini}"
    },
    "foundryIqChatModelVersion": {
      "value": "${FOUNDRY_IQ_CHAT_MODEL_VERSION=2026-03-17}"
    },
    "foundryIqChatModelSkuName": {
      "value": "${FOUNDRY_IQ_CHAT_MODEL_SKU_NAME=GlobalStandard}"
    },
    "foundryIqChatModelCapacity": {
      "value": "${FOUNDRY_IQ_CHAT_MODEL_CAPACITY=10}"
    },
    "foundryIqEmbeddingDeploymentName": {
      "value": "${FOUNDRY_IQ_EMBEDDING_DEPLOYMENT_NAME=foundry-iq-embedding}"
    },
    "foundryIqEmbeddingModelName": {
      "value": "${FOUNDRY_IQ_EMBEDDING_MODEL_NAME=text-embedding-3-large}"
    },
    "foundryIqEmbeddingModelVersion": {
      "value": "${FOUNDRY_IQ_EMBEDDING_MODEL_VERSION=1}"
    },
    "foundryIqEmbeddingModelSkuName": {
      "value": "${FOUNDRY_IQ_EMBEDDING_MODEL_SKU_NAME=GlobalStandard}"
    },
    "foundryIqEmbeddingModelCapacity": {
      "value": "${FOUNDRY_IQ_EMBEDDING_MODEL_CAPACITY=10}"
    },
    "vnetName": {
      "value": "${AZURE_VIRTUAL_NETWORK_NAME=maf-poc-vnet}"
    },
    "vnetAddressPrefix": {
      "value": "${AZURE_VNET_ADDRESS_PREFIX=192.168.0.0/16}"
    },
    "agentSubnetPrefix": {
      "value": "${AZURE_AGENT_SUBNET_PREFIX=192.168.0.0/24}"
    },
    "peSubnetPrefix": {
      "value": "${AZURE_PE_SUBNET_PREFIX=192.168.1.0/24}"
    },
    "enableContainerRegistry": {
      "value": "${AZURE_ENABLE_CONTAINER_REGISTRY=true}"
    },
    "developerIpCidr": {
      "value": "${AZURE_ACR_DEVELOPER_IP_CIDR=}"
    },
    "allowedClientIpCidr": {
      "value": "${AZURE_ALLOWED_CLIENT_IP_CIDR}"
    },
    "searchIndexName": {
      "value": "${AZURE_SEARCH_INDEX_NAME=maf-poc-knowledge}"
    },
    "foundryIqContainerName": {
      "value": "${FOUNDRY_IQ_STORAGE_CONTAINER_NAME=knowledge}"
    },
    "foundryIqKnowledgeSourceName": {
      "value": "${FOUNDRY_IQ_KNOWLEDGE_SOURCE_NAME=maf-poc-knowledge-source}"
    },
    "foundryIqKnowledgeBaseName": {
      "value": "${FOUNDRY_IQ_KNOWLEDGE_BASE_NAME=maf-poc-knowledge-base}"
    },
    "foundryIqIngestionInterval": {
      "value": "${FOUNDRY_IQ_INGESTION_INTERVAL=PT1H}"
    },
    "cosmosWorkloadDatabaseName": {
      "value": "${AZURE_COSMOS_DATABASE_NAME=agent-framework}"
    },
    "cosmosWorkloadContainerName": {
      "value": "${AZURE_COSMOS_CONTAINER_NAME=chat-history}"
    },
    "cosmosWorkloadPartitionKeyPath": {
      "value": "${AZURE_COSMOS_PARTITION_KEY_PATH=/session_id}"
    },
    "intakeContainerAppsSubnetResourceId": {
      "value": "${AZURE_INTAKE_CONTAINER_APPS_SUBNET_ID=}"
    },
    "intakeApiImageName": {
      "value": "${SERVICE_INTAKE_API_IMAGE_NAME=}"
    },
    "intakeContainerAppsSubnetPrefix": {
      "value": "${AZURE_INTAKE_CONTAINER_APPS_SUBNET_PREFIX=192.168.4.0/23}"
    },
    "intakeCosmosDatabaseName": {
      "value": "${INTAKE_COSMOS_DATABASE_NAME=intake}"
    },
    "intakeCosmosContainerName": {
      "value": "${INTAKE_COSMOS_CONTAINER_NAME=intake-requests}"
    },
    "intakeEntraTenantId": {
      "value": "${INTAKE_ENTRA_TENANT_ID}"
    },
    "intakeEntraAudience": {
      "value": "${INTAKE_ENTRA_AUDIENCE}"
    },
    "intakeDelegatedWriteScope": {
      "value": "${INTAKE_DELEGATED_WRITE_SCOPE=Intake.ReadWrite}"
    },
    "intakePrivilegedReadRole": {
      "value": "${INTAKE_PRIVILEGED_READ_ROLE=Intake.Read.All}"
    },
    "intakePrivilegedWriteRole": {
      "value": "${INTAKE_PRIVILEGED_WRITE_ROLE=Intake.ReadWrite.All}"
    },
    "intakeApiMinReplicas": {
      "value": "${INTAKE_API_MIN_REPLICAS=1}"
    },
    "intakeApiMaxReplicas": {
      "value": "${INTAKE_API_MAX_REPLICAS=5}"
    },
    "intakeApiLogLevel": {
      "value": "${LOG_LEVEL=INFO}"
    },
    "adminSubnetPrefix": {
      "value": "${AZURE_ADMIN_SUBNET_PREFIX=192.168.2.0/24}"
    },
    "deployAdminAccess": {
      "value": "${AZURE_DEPLOY_ADMIN_ACCESS=false}"
    },
    "bastionSubnetPrefix": {
      "value": "${AZURE_BASTION_SUBNET_PREFIX=192.168.3.0/26}"
    },
    "adminUsername": {
      "value": "${AZURE_ADMIN_VM_USERNAME=azadmin}"
    },
    "adminPassword": {
      "value": "${AZURE_ADMIN_VM_PASSWORD}"
    }
  }
}
