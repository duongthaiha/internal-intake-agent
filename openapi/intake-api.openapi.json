      "IntakeRequest": {
        "title": "Innovation and AI use case intake request",
        "description": "Captures the core idea and optional discovery details for an innovation or AI use case request.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "problemOpportunity",
          "proposedIdea",
          "expectedOutcome",
          "requester"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "A short, recognizable name for the request.",
            "minLength": 3,
            "maxLength": 150
          },
          "problemOpportunity": {
            "type": "string",
            "description": "The current problem, unmet need, or opportunity and why it matters.",
            "minLength": 20,
            "maxLength": 5000
          },
          "proposedIdea": {
            "type": "string",
            "description": "The proposed innovation or AI-enabled approach.",
            "minLength": 20,
            "maxLength": 5000
          },
          "expectedOutcome": {
            "type": "string",
            "description": "The desired result and the change expected if the idea succeeds.",
            "minLength": 10,
            "maxLength": 3000
          },
          "requester": {
            "$ref": "#/components/schemas/IntakeRequest_requiredPerson",
            "description": "The person submitting the request."
          },
          "businessContext": {
            "$ref": "#/components/schemas/IntakeRequest_businessContext"
          },
          "targetUsers": {
            "$ref": "#/components/schemas/IntakeRequest_targetUsers"
          },
          "valueAndSuccess": {
            "$ref": "#/components/schemas/IntakeRequest_valueAndSuccess"
          },
          "aiConsiderations": {
            "$ref": "#/components/schemas/IntakeRequest_aiConsiderations"
          },
          "dataConsiderations": {
            "$ref": "#/components/schemas/IntakeRequest_dataConsiderations"
          },
          "dependencies": {
            "type": "array",
            "description": "Systems, teams, initiatives, approvals, or other dependencies.",
            "items": {
              "$ref": "#/components/schemas/IntakeRequest_dependency"
            },
            "maxItems": 50,
            "uniqueItems": true
          },
          "deliveryConsiderations": {
            "$ref": "#/components/schemas/IntakeRequest_deliveryConsiderations"
          },
          "risks": {
            "type": "array",
            "description": "Known delivery, adoption, operational, legal, or technical risks.",
            "items": {
              "$ref": "#/components/schemas/IntakeRequest_risk"
            },
            "maxItems": 50
          },
          "responsibleAI": {
            "$ref": "#/components/schemas/IntakeRequest_responsibleAI"
          },
          "securityAndPrivacy": {
            "$ref": "#/components/schemas/IntakeRequest_securityAndPrivacy"
